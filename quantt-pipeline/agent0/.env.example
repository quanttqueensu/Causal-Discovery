# Alpaca paper-trading credentials.
# Copy this file to .env and fill in your real keys. Do NOT commit .env.
# Get keys from https://app.alpaca.markets (Paper Trading -> View API Keys).

APCA_API_KEY_ID=your_paper_api_key_id_here
APCA_API_SECRET_KEY=your_paper_api_secret_key_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets
